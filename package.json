{
  "name": "dataviz-france",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "data:geo": "python3 tools/fetch_geo.py && mapshaper data/raw/departements.geojson -simplify 6% keep-shapes -o format=topojson public/data/geo/fr-departements.topo.json",
    "data:prenoms": "python3 tools/prepare_prenoms.py",
    "data:prenoms-top5": "python3 tools/prepare_prenoms_top5.py",
    "data:prix": "python3 tools/prepare_prix.py",
    "data:doublettes": "python3 tools/prepare_doublettes.py",
    "reel": ".venv/bin/python tools/make_reel.py"
  },
  "dependencies": {
    "d3-color": "^3.1.0",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-color": "^3.1.3",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.4",
    "mapshaper": "^0.7.53",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
